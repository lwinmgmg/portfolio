# Replica set required. MongoDB Atlas works. A standalone mongod rejects transactions.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# Single admin. There is no user signup.
# JWT_SECRET: openssl rand -base64 32
# ADMIN_PASSWORD_HASH: printf '%s' 'your-password' | bun scripts/hash-admin-password.ts
# The script writes \$ so Next.js does not expand $ in the hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt\$replace\$with-hash-script-output
JWT_SECRET=openssl-rand-base64-32

# OpenRouter. Required for CV extraction and chat. Blank disables LLM features.
OPENROUTER_API_KEY=
# Optional. Sent as the HTTP-Referer header.
OPENROUTER_APP_URL=
# Optional. Sent as the X-Title header. Defaults to portfolio.
OPENROUTER_APP_NAME=portfolio
# CV extraction. Needs structured outputs; the default PDF mode sends Markdown text.
LLM_EXTRACT_MODEL=deepseek/deepseek-v4.1-flash
# PDF processing: pdf-to-md converts locally; other values use OpenRouter's file-parser.
LLM_PDF_ENGINE=pdf-to-md
# Query rewrite and chunk context. Supports structured output; this endpoint is paid.
LLM_UTILITY_MODEL=nvidia/nemotron-3.5-lightning
# Chat answers.
LLM_ANSWER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Embeddings.
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Reranking.
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# Global chat cost guard: user messages per UTC day. Defaults to 500.
CHAT_DAILY_MESSAGE_LIMIT=500
# Private Vercel Blob store token for client uploads. Pull with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
